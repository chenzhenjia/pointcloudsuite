{
  // 首版点云平面输出契约；所有 outputs 路径均相对于 runtime_data/jobs/<job_id>。
  "schema": "point-cloud-plane-output-v0.1-proposal",
  "job_id": "job_demo_001",
  "workpiece_id": "workpiece_demo_001",
  "source_point_cloud": "point_cloud/raw/input.ply",
  "units": {"length": "mm", "angle": "deg"},
  "coordinate_frames": {"source": "robot_base", "workpiece": "workpiece"},
  "image": {
    "file": "point_cloud/plane/demo.png",
    "width_px": 0, "height_px": 0, "pixel_size_mm": 0.05,
    "origin": "top_left", "u_axis": "workpiece_x_positive",
    "v_axis": "workpiece_y_negative", "background_value": 0,
    "foreground_value": 255
  },
  "workpiece_coordinate": {
    "origin_in_robot_base": {"x": 0, "y": 0, "z": 0},
    "x_axis": {"x": 1, "y": 0, "z": 0},
    "y_axis": {"x": 0, "y": 1, "z": 0},
    "z_axis": {"x": 0, "y": 0, "z": 1},
    "abc_deg": {"a": 0, "b": 0, "c": 0},
    "T_base_workpiece": [], "T_workpiece_base": []
  },
  "plane": {
    "equation": {"a": 0, "b": 0, "c": 1, "d": 0},
    "rms_error_mm": 0, "distance_tolerance_mm": 0.4
  },
  "outputs": {
    "plane_png": "point_cloud/plane/demo.png",
    "plane_json": "point_cloud/plane/demo.json",
    "plane_robot_base_ply": "point_cloud/plane/demo_plane_robot_base.ply"
  },
  "status": {"success": true, "error_code": "", "message": ""}
}
