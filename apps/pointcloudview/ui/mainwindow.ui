  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#main_window, QWidget#wgt_central,
QWidget#wgt_source_panel, QWidget#wgt_render, QWidget#wgt_clean,
QWidget#wgt_plane, QWidget#wgt_edge, QWidget#tw_main,
QWidget#toolbar_workflow, QFrame, QStackedWidget {
    background-color: #ffffff;
    color: #1f2937;
    font-family: &quot;Microsoft YaHei&quot;;
    font-size: 10pt;
}
QWidget { background-color: #ffffff; color: #344054; }
QMenuBar, QToolBar, QMenu, QAbstractItemView {
    background-color: #ffffff;
    color: #1f2937;
    border-bottom: 1px solid #d9e0e8;
    padding: 2px 8px;
}
QMenuBar::item { padding: 5px 12px; }
QMenuBar::item:selected, QMenu::item:selected, QToolButton:hover { background-color: #edf5ff; color: #1769aa; }
QMenu { border: 1px solid #d9e0e8; padding: 4px; }
QMenu::item { padding: 6px 24px 6px 12px; }
QToolButton { color: #344054; border: 1px solid transparent; border-radius: 4px; padding: 4px 8px; }
QToolButton:checked { background-color: #e5f1ff; color: #1769aa; border-color: #91caff; }
QPushButton {
    background-color: #ffffff;
    color: #344054;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 6px 14px;
    min-height: 28px;
}
QPushButton:hover { background-color: #edf5ff; border-color: #5b9bd5; color: #1769aa; }
QPushButton:pressed { background-color: #dceeff; }
QPushButton:disabled { color: #98a2b3; background-color: #f5f7fa; border-color: #e3e8ef; }
QLineEdit, QPlainTextEdit, QListWidget, QComboBox, QSpinBox, QDoubleSpinBox,
QAbstractSpinBox, QScrollArea, QScrollBar {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 4px 6px;
    selection-background-color: #b9ddff;
}
QListWidget { outline: none; }
QListWidget::item { padding: 7px 8px; border-radius: 3px; }
QListWidget::item:selected { background-color: #dceeff; color: #1769aa; }
QAbstractItemView { background-color: #ffffff; color: #1f2937; border: 1px solid #cbd5e1; selection-background-color: #dceeff; selection-color: #1769aa; }
QComboBox QAbstractItemView { background-color: #ffffff; color: #1f2937; border: 1px solid #cbd5e1; padding: 2px; }
QComboBox::drop-down { background-color: #f5f7fa; border-left: 1px solid #d9e0e8; width: 22px; }
QComboBox::down-arrow { image: none; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid #667085; width: 0; height: 0; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { background-color: #f5f7fa; border-left: 1px solid #d9e0e8; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #edf5ff; }
QScrollBar:vertical { background: #f5f7fa; width: 12px; margin: 0; }
QScrollBar:horizontal { background: #f5f7fa; height: 12px; margin: 0; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #cbd5e1; border-radius: 5px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #91caff; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { background: none; border: none; }
QCheckBox { color: #344054; spacing: 6px; }
QCheckBox::indicator { width: 15px; height: 15px; border: 1px solid #98a2b3; border-radius: 3px; background: #ffffff; }
QCheckBox::indicator:checked { background: #2f80c9; border-color: #2472b8; }
QCheckBox::indicator:disabled { background: #f5f7fa; border-color: #d9e0e8; }
QTabWidget::pane { border: 1px solid #d9e0e8; background-color: #ffffff; }
QTabBar::tab { background-color: #f5f7fa; color: #667085; padding: 8px 14px; border: 1px solid #d9e0e8; border-bottom: none; }
QTabBar::tab:selected { color: #1769aa; background-color: #ffffff; }
QGroupBox { border: 1px solid #d9e0e8; border-radius: 5px; margin-top: 10px; padding: 10px 8px 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; color: #1769aa; }
QSplitter::handle { background-color: #e7ecf2; }
QStatusBar { background-color: #f8fafc; color: #667085; border-top: 1px solid #d9e0e8; }
QProgressBar { background-color: #e7ecf2; border: none; height: 3px; }
QProgressBar::chunk { background-color: #2f80c9; }
QLabel#lbl_main_title { color: #172b4d; font-size: 15pt; font-weight: 600; }
QLabel { color: #344054; }
QLabel#lbl_header_subtitle, QLabel#lbl_file_info, QLabel#lbl_canvas_info { color: #667085; }
QLabel#lbl_workflow_title, QLabel#lbl_source_title, QLabel#lbl_render_title, QLabel#lbl_clean_title, QLabel#lbl_plane_title, QLabel#lbl_edge_title { color: #1769aa; font-size: 11pt; font-weight: 600; padding: 4px 0; }
QPushButton#btn_open_point_cloud, QPushButton#btn_open_scanning_info { background-color: #2f80c9; border-color: #2472b8; color: #ffffff; }
QPushButton#btn_open_point_cloud:hover, QPushButton#btn_open_scanning_info:hover { background-color: #1769aa; }
QLabel#lbl_device_empty { color: #667085; padding: 18px 8px; }
QWidget#wgt_canvas_panel { background-color: #f8fafc; border: 1px solid #d9e0e8; }
QWidget#wgt_canvas_host { background-color: #ffffff; }
</string>
