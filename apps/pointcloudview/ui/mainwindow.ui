           <attribute name="title">
            <string>边缘处理</string>
           </attribute>
           <layout class="QVBoxLayout" name="vbl_edge">
            <item>
             <widget class="QLabel" name="lbl_edge_title">
              <property name="text">
               <string>平面边缘分割</string>
              </property>
             </widget>
            </item>
            <item>
             <layout class="QFormLayout" name="fml_edge">
              <item row="0" column="0">
               <widget class="QLabel" name="lbl_edge_grid">
                <property name="text">
                 <string>栅格尺寸 mm</string>
                </property>
               </widget>
              </item>
              <item row="0" column="1">
               <widget class="QDoubleSpinBox" name="dsb_edge_grid">
                <property name="decimals">
                 <number>4</number>
                </property>
                <property name="maximum">
                 <double>1000.000000000000000</double>
                </property>
                <property name="value">
                 <double>0.200000000000000</double>
                </property>
               </widget>
              </item>
              <item row="1" column="0">
               <widget class="QLabel" name="lbl_edge_close">
                <property name="text">
                 <string>闭运算半径</string>
                </property>
               </widget>
              </item>
              <item row="1" column="1">
               <widget class="QSpinBox" name="spb_edge_close">
                <property name="maximum">
                 <number>4</number>
                </property>
                <property name="value">
                 <number>1</number>
                </property>
               </widget>
              </item>
              <item row="2" column="0">
               <widget class="QLabel" name="lbl_edge_open">
                <property name="text">
                 <string>开运算半径</string>
                </property>
               </widget>
              </item>
              <item row="2" column="1">
               <widget class="QSpinBox" name="spb_edge_open">
                <property name="maximum">
                 <number>4</number>
                </property>
                <property name="value">
                 <number>1</number>
                </property>
               </widget>
              </item>
              <item row="3" column="0">
               <widget class="QLabel" name="lbl_plane_image_width">
                <property name="text">
                 <string>图片宽度 mm</string>
                </property>
               </widget>
              </item>
              <item row="3" column="1">
               <widget class="QDoubleSpinBox" name="dsb_plane_image_width">
                <property name="decimals">
                 <number>2</number>
                </property>
                <property name="minimum">
                 <double>1.000000000000000</double>
                </property>
                <property name="maximum">
                 <double>10000.000000000000000</double>
                </property>
                <property name="value">
                 <double>100.000000000000000</double>
                </property>
               </widget>
              </item>
              <item row="4" column="0">
               <widget class="QLabel" name="lbl_plane_image_height">
                <property name="text">
                 <string>图片高度 mm</string>
                </property>
               </widget>
              </item>
              <item row="4" column="1">
               <widget class="QDoubleSpinBox" name="dsb_plane_image_height">
                <property name="decimals">
                 <number>2</number>
                </property>
                <property name="minimum">
                 <double>1.000000000000000</double>
                </property>
                <property name="maximum">
                 <double>10000.000000000000000</double>
                </property>
                <property name="value">
                 <double>100.000000000000000</double>
                </property>
               </widget>
              </item>
             </layout>
            </item>
            <item>
             <widget class="QPushButton" name="btn_extract_plane_image">
              <property name="text">
               <string>提取平面 2D 图像</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btn_finalize_temp_workpiece">
              <property name="text">
               <string>提交临时工件四件套</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btn_apply_edge">
              <property name="text">
               <string>执行边缘分割</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btn_select_edge">
              <property name="text">
               <string>选择边缘点</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btn_clear_edge">
              <property name="text">
               <string>清除边缘选择</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btn_save_plane_image">
              <property name="text">
               <string>保存 2D 图片</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="lbl_plane_image_preview">
              <property name="minimumSize">
               <size>
                <width>0</width>
                <height>150</height>
               </size>
              </property>
              <property name="text">
               <string>确认平面后执行边缘分割</string>
              </property>
              <property name="alignment">
               <set>Qt::AlignmentFlag::AlignCenter</set>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPlainTextEdit" name="pte_edge_output">
              <property name="readOnly">
               <bool>true</bool>
              </property>
              <property name="placeholderText">
               <string>边缘和 2D 图像统计将在此显示</string>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="lbl_source_title">
          <property name="text">
           <string>设备 / 数据源</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QListWidget" name="lw_files">
          <property name="selectionMode">
           <enum>QAbstractItemView::SelectionMode::ExtendedSelection</enum>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="lbl_device_empty">
          <property name="text">
           <string>暂无设备数据
连接功能待接入

尚未加载点云</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btn_device_placeholder">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="text">
           <string>设备连接（待接入）</string>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
      <widget class="QWidget" name="wgt_canvas_panel">
       <layout class="QVBoxLayout" name="vbl_canvas">
        <property name="spacing">
         <number>0</number>
        </property>
        <property name="leftMargin">
         <number>6</number>
        </property>
        <property name="topMargin">
         <number>0</number>
        </property>
        <property name="rightMargin">
         <number>6</number>
        </property>
        <property name="bottomMargin">
         <number>0</number>
        </property>
        <item>
         <widget class="QWidget" name="wgt_canvas_host" native="true">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="lbl_canvas_info">
          <property name="text">
           <string>就绪</string>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
    <item>
     <widget class="QProgressBar" name="pbar_progress">
      <property name="maximum">
       <number>100</number>
      </property>
      <property name="textVisible">
       <bool>false</bool>
      </property>
     </widget>
    </item>
   </layout>
