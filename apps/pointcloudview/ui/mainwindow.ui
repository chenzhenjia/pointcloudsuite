 <property name="windowTitle">
   <string>点云预览工作台</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#main_window, QWidget#wgt_central {
    background-color: #1d2027;
    color: #e7eaf0;
    font-family: "Microsoft YaHei";
    font-size: 10pt;
}
QMenuBar {
    background-color: #17191e;
    color: #d9dde7;
    border-bottom: 1px solid #343944;
    padding: 2px 8px;
}
QMenuBar::item { padding: 5px 12px; }
QMenuBar::item:selected { background-color: #303641; }
QPushButton {
    background-color: #303641;
    color: #e7eaf0;
    border: 1px solid #474e5b;
    border-radius: 4px;
    padding: 6px 14px;
    min-height: 28px;
}
QPushButton:hover { background-color: #3b4350; border-color: #5b8def; }
QPushButton:pressed { background-color: #252b35; }
QPushButton:disabled { color: #737a88; background-color: #252931; border-color: #343944; }
QLineEdit, QPlainTextEdit, QListWidget, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #252931;
    color: #e7eaf0;
    border: 1px solid #3c4350;
    border-radius: 4px;
    padding: 4px 6px;
    selection-background-color: #3d6fc4;
}
QListWidget { outline: none; }
QListWidget::item { padding: 7px 8px; border-radius: 3px; }
QListWidget::item:selected { background-color: #315b9d; color: white; }
QTabWidget::pane { border: 1px solid #3c4350; background-color: #23262e; }
QTabBar::tab { background-color: #292d35; color: #aeb5c2; padding: 8px 14px; border: 1px solid #3c4350; border-bottom: none; }
QTabBar::tab:selected { color: white; background-color: #3d6fc4; }
QGroupBox { border: 1px solid #3c4350; border-radius: 5px; margin-top: 10px; padding: 10px 8px 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; color: #9fbdf5; }
QSplitter::handle { background-color: #343944; }
QStatusBar { background-color: #17191e; color: #9ea6b5; border-top: 1px solid #343944; }
QProgressBar { background-color: #292d35; border: none; height: 3px; }
QProgressBar::chunk { background-color: #5b8def; }
QLabel#lbl_main_title { color: #f1f3f7; font-size: 15pt; font-weight: 600; }
QLabel#lbl_header_subtitle, QLabel#lbl_file_info, QLabel#lbl_canvas_info { color: #8e98a8; }
QLabel#lbl_source_title, QLabel#lbl_render_title, QLabel#lbl_clean_title, QLabel#lbl_plane_title, QLabel#lbl_edge_title { color: #9fbdf5; font-size: 11pt; font-weight: 600; padding: 4px 0; }
QPushButton#btn_open_point_cloud, QPushButton#btn_open_scanning_info { background-color: #d86d12; border-color: #ee8421; }
QPushButton#btn_open_point_cloud:hover, QPushButton#btn_open_scanning_info:hover { background-color: #ee8421; }
QLabel#lbl_device_empty { color: #7f8999; padding: 18px 8px; }
QWidget#wgt_canvas_panel { background-color: #090a0d; border: 1px solid #343944; }
QWidget#wgt_canvas_host { background-color: #000000; }
</string>
