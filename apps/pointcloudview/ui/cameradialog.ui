<ui version="4.0">
 <class>CameraDialog</class>
 <widget class="QDialog" name="CameraDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>860</width><height>560</height></rect>
  </property>
  <property name="minimumSize">
   <size><width>760</width><height>500</height></size>
  </property>
  <property name="windowTitle"><string>相机设备与实时取流</string></property>
  <property name="styleSheet">
   <string notr="true">QDialog { background:#ffffff; color:#1f2937; font-family:"Microsoft YaHei"; font-size:10pt; }
QGroupBox { border:1px solid #d9e0e8; border-radius:5px; margin-top:10px; padding:12px 10px 10px; }
QGroupBox::title { subcontrol-origin:margin; left:10px; padding:0 5px; color:#1769aa; }
QLabel { color:#475467; }
QLabel#lbl_status { color:#16803c; font-weight:600; }
QLabel#lbl_device_model_value, QLabel#lbl_device_serial_value, QLabel#lbl_device_ip_value, QLabel#lbl_device_virtual_value { color:#172b4d; font-weight:600; }
QComboBox, QPushButton { min-height:28px; border:1px solid #cbd5e1; border-radius:4px; padding:4px 8px; background:#ffffff; color:#344054; }
QComboBox:hover, QPushButton:hover { border-color:#5b9bd5; background:#edf5ff; }
QPushButton:disabled { color:#98a2b3; background:#f5f7fa; border-color:#e3e8ef; }
QPushButton#btn_connect, QPushButton#btn_start { background:#2f80c9; border-color:#2472b8; color:white; }
QPlainTextEdit { background:#ffffff; color:#344054; border:1px solid #cbd5e1; border-radius:4px; }
</string>
  </property>
  <layout class="QVBoxLayout" name="rootLayout">
   <property name="leftMargin"><number>12</number></property>
   <property name="topMargin"><number>12</number></property>
   <property name="rightMargin"><number>12</number></property>
   <property name="bottomMargin"><number>12</number></property>
   <property name="spacing"><number>10</number></property>
   <item>
    <layout class="QHBoxLayout" name="contentLayout">
     <property name="spacing"><number>10</number></property>
     <item>
      <widget class="QGroupBox" name="gb_devices">
       <property name="title"><string>设备列表</string></property>
       <layout class="QVBoxLayout" name="deviceLayout">
        <property name="spacing"><number>8</number></property>
        <item><widget class="QLabel" name="lbl_device_hint"><property name="text"><string>已发现设备</string></property></widget></item>
        <item><widget class="QComboBox" name="cb_devices"/></item>
        <item><widget class="QPushButton" name="btn_refresh"><property name="text"><string>刷新设备</string></property></widget></item>
        <item><spacer name="deviceSpacer"><property name="orientation"><enum>Qt::Orientation::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>80</height></size></property></spacer></item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="gb_stream">
       <property name="title"><string>设备详情与取流</string></property>
       <layout class="QFormLayout" name="streamForm">
        <property name="horizontalSpacing"><number>10</number></property>
        <property name="verticalSpacing"><number>8</number></property>
        <item row="0" column="0"><widget class="QLabel" name="lbl_device_model"><property name="text"><string>型号</string></property></widget></item>
        <item row="0" column="1"><widget class="QLabel" name="lbl_device_model_value"><property name="text"><string>-</string></property></widget></item>
        <item row="1" column="0"><widget class="QLabel" name="lbl_device_serial"><property name="text"><string>序列号</string></property></widget></item>
        <item row="1" column="1"><widget class="QLabel" name="lbl_device_serial_value"><property name="text"><string>-</string></property></widget></item>
        <item row="2" column="0"><widget class="QLabel" name="lbl_device_ip"><property name="text"><string>IP 地址</string></property></widget></item>
        <item row="2" column="1"><widget class="QLabel" name="lbl_device_ip_value"><property name="text"><string>-</string></property></widget></item>
        <item row="3" column="0"><widget class="QLabel" name="lbl_device_virtual"><property name="text"><string>设备类型</string></property></widget></item>
        <item row="3" column="1"><widget class="QLabel" name="lbl_device_virtual_value"><property name="text"><string>-</string></property></widget></item>
        <item row="4" column="0"><widget class="QLabel" name="lbl_mode"><property name="text"><string>取流模式</string></property></widget></item>
        <item row="4" column="1"><widget class="QComboBox" name="cb_mode"><item><property name="text"><string>深度图 Range_Image（推荐）</string></property></item><item><property name="text"><string>点云图 PointCloud_Image</string></property></item><item><property name="text"><string>自动（按帧类型自适应）</string></property></item></widget></item>
        <item row="5" column="0"><widget class="QLabel" name="lbl_trigger"><property name="text"><string>触发方式</string></property></widget></item>
        <item row="5" column="1"><layout class="QHBoxLayout" name="triggerLayout"><item><widget class="QComboBox" name="cb_trigger"><item><property name="text"><string>连续取流</string></property></item><item><property name="text"><string>软触发</string></property></item></widget></item><item><widget class="QPushButton" name="btn_trigger"><property name="enabled"><bool>false</bool></property><property name="text"><string>触发一帧</string></property></widget></item></layout></item>
        <item row="6" column="0"><widget class="QLabel" name="lbl_status_title"><property name="text"><string>状态</string></property></widget></item>
        <item row="6" column="1"><widget class="QLabel" name="lbl_status"><property name="text"><string>未连接</string></property></widget></item>
        <item row="7" column="0"><widget class="QLabel" name="lbl_frame_title"><property name="text"><string>帧信息</string></property></widget></item>
        <item row="7" column="1"><widget class="QLabel" name="lbl_frame"><property name="text"><string>帧：-</string></property></widget></item>
        <item row="8" column="0"><widget class="QLabel" name="lbl_rate_title"><property name="text"><string>帧率</string></property></widget></item>
        <item row="8" column="1"><widget class="QLabel" name="lbl_rate"><property name="text"><string>帧率：-</string></property></widget></item>
        <item row="9" column="0" colspan="2"><layout class="QHBoxLayout" name="actionLayout"><item><widget class="QPushButton" name="btn_connect"><property name="text"><string>连接</string></property></widget></item><item><widget class="QPushButton" name="btn_start"><property name="enabled"><bool>false</bool></property><property name="text"><string>开始取流</string></property></widget></item></layout></item>
       </layout>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QGroupBox" name="gb_camera_params">
     <property name="title"><string>相机参数（SDK 参数接口待接入）</string></property>
     <layout class="QFormLayout" name="cameraParamForm">
      <item row="0" column="0"><widget class="QLabel" name="lbl_laser_enable"><property name="text"><string>激光器使能</string></property></widget></item>
      <item row="0" column="1"><widget class="QCheckBox" name="chk_laser_enable"><property name="enabled"><bool>false</bool></property><property name="text"><string>待接入</string></property></widget></item>
      <item row="0" column="2"><widget class="QLabel" name="lbl_roi"><property name="text"><string>ROI 选择</string></property></widget></item>
      <item row="0" column="3"><widget class="QComboBox" name="cb_roi"><property name="enabled"><bool>false</bool></property><item><property name="text"><string>待接入</string></property></item></widget></item>
      <item row="1" column="0"><widget class="QLabel" name="lbl_frame_rate"><property name="text"><string>实际采集帧率</string></property></widget></item>
      <item row="1" column="1"><widget class="QLineEdit" name="le_frame_rate"><property name="enabled"><bool>false</bool></property><property name="text"><string>SDK 参数接口待接入</string></property></widget></item>
      <item row="1" column="2"><widget class="QLabel" name="lbl_sensitivity"><property name="text"><string>感光灵敏度</string></property></widget></item>
      <item row="1" column="3"><widget class="QComboBox" name="cb_sensitivity"><property name="enabled"><bool>false</bool></property><item><property name="text"><string>待接入</string></property></item></widget></item>
     </layout>
    </widget>
   </item>
   <item><widget class="QLabel" name="lbl_footer"><property name="text"><string>实时帧将在主窗口中央画布显示；异常时自动尝试重连。</string></property></widget></item>
  </layout>
