{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-msvc-release",
      "displayName": "Windows Qt 6 Release",
      "binaryDir": "${sourceDir}/../build-${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PCV_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows Qt 6 Debug with tests",
      "binaryDir": "${sourceDir}/../build-${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PCV_BUILD_TESTS": "ON",
        "PCV_BUILD_TOOLS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "build-release", "configurePreset": "windows-msvc-release" },
    { "name": "build-debug", "configurePreset": "windows-msvc-debug" }
  ],
  "testPresets": [
    {
      "name": "test-debug",
      "configurePreset": "windows-msvc-debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
